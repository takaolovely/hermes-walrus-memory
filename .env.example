# hermes-walrus-memory configuration
#
# The plugin works with none of these set: it runs as a local tamper-evident
# ledger. Everything below only adds the Walrus Mainnet layer.
#
# Copy to .env and fill in, or export in your shell. Never commit a real key.

# --- Walrus credentials (needed for sync, push, pull, verify against chain)
WALRUS_DELEGATE_KEY=
WALRUS_ACCOUNT_ID=
WALRUS_NAMESPACE=hermes-walrus-memory
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# --- SEAL session (needed only to READ sealed blobs back)
# Tier 1: paste a literal session string.
WALRUS_SEAL_SESSION=
# Tier 2: a command that prints {"ok": true, "session": "..."} and exits 0.
# WALRUS_SEAL_BRIDGE=node /absolute/path/to/tools/seal_session.mjs
# Directory whose node_modules holds @mysten-incubation/memwal, for the bridge.
WALRUS_SEAL_SDK_ROOT=

# --- Local paths and timeouts
WALRUS_LEDGER_PATH=
HERMES_MEMORY_MD=
WALRUS_HTTP_TIMEOUT=6
WALRUS_SEAL_BRIDGE_TIMEOUT=8
